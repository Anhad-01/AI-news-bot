# Required — obtain from https://groq.com
GROQ_API_KEY=your_groq_api_key

# Required — obtain from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# Required — create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Required — the chat or channel ID to send digests to
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional — defaults to openai/gpt-oss-120b
MODEL_NAME=openai/gpt-oss-120b

# Optional — max articles per topic agent (5 agents x N = total max articles); defaults to 1
MAX_RESULTS=1

# Optional — path for the run log file; defaults to ai-news-bot.log in the project root
AI_NEWS_BOT_LOG=ai-news-bot.log
